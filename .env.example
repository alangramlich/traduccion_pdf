# Copiá este archivo a .env y poné tu clave real:
#     cp .env.example .env
# El archivo .env está en .gitignore: tu clave NO se sube a git.
#
# Obtené una API key en https://aistudio.google.com/apikey

GEMINI_API_KEY=tu_clave_aca

# Opcional: modelo a usar (por defecto gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
